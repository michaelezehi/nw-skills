// — Per-flow accent ——————————————————————————————————————

export const ACCENT_PRIMARY = '{{ACCENT_BG}}';
export const ACCENT_PRIMARY_INK = '{{ACCENT_INK}}';

export type FlowAccent = 'primary'; // extend with additional flow names

export interface AccentTokens {
  bg: string;
  ink: string;
  /** True when the accent surface is light and needs dark ink for contrast.
   *  Avoids hex-string comparisons at consumer sites. */
  isLight: boolean;
}

export function getAccent(flow: FlowAccent = 'primary'): AccentTokens {
  switch (flow) {
    case 'primary':
    default:
      return {
        bg: ACCENT_PRIMARY,
        ink: ACCENT_PRIMARY_INK,
        isLight: {{ACCENT_IS_LIGHT}},
      };
  }
}

