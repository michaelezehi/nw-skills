                className="font-mono text-[11px] uppercase tracking-[0.32em]"
                style={{ color: SMOKE }}
              >
                {label}
              </span>
            ))}
          </div>
        </motion.div>

        <div className="mt-12 flex items-start gap-8 md:mt-20">
          <motion.h2
            variants={item}
            className="flex-1 text-[clamp(2.4rem,6.4vw,5.6rem)] font-medium leading-[0.96] tracking-[-0.035em]"
            style={{ color: INK, fontFamily: 'var(--font-geist-sans), system-ui, sans-serif' }}
