'use client';
// the-broadside extended layout variants (v6–v9). Shares EditorialFrame +
// primitives with the original five. Adds optional layout-specific slots:
// numeral, wordmark, cta, socialLinks, brandMark, caption, nav.

import { motion, useReducedMotion, type Variants } from 'motion/react';
import { ReactNode } from 'react';
import { ArrowRight, ArrowUpRight } from '@phosphor-icons/react';
import { EditorialPlate, useAccent, type EditorialCard } from './slide';
import {
  ASH,
  CARD,
  DURATION,
  EASE,
  IMAGE_FILTER,
  INK,
  MIST,
  SMOKE,
  STAGGER,
  Y_DISTANCE,
} from './tokens';
import type { EditorialLayoutProps } from './layouts';

// — Serif font stack — works in any project (uses system serif fallback when no custom font loaded).
const SERIF_STACK =
  "'Cormorant Garamond', 'Playfair Display', 'Source Serif Pro', 'Iowan Old Style', Georgia, 'Times New Roman', serif";

/** Inline serif accent for editorial typography mixes. Use inside headline JSX. */
export function SerifAccent({
  children,
  italic = true,
  className = '',
}: {
  children: ReactNode;
  italic?: boolean;
  className?: string;
}) {
  return (
    <span
      className={className}
      style={{ fontFamily: SERIF_STACK, fontStyle: italic ? 'italic' : 'normal', fontWeight: 400 }}
    >
      {children}
    </span>
  );
}

function useAnim() {
  const prefersReduced = useReducedMotion();
  const container = {
    hidden: { opacity: 0 },
    visible: { opacity: 1, transition: { staggerChildren: STAGGER, delayChildren: 0.08 } },
  } satisfies Variants;
  const item = (
    prefersReduced
      ? { hidden: { opacity: 0 }, visible: { opacity: 1, transition: { duration: DURATION } } }
      : {
          hidden: { opacity: 0, y: Y_DISTANCE },
          visible: { opacity: 1, y: 0, transition: { duration: DURATION, ease: [...EASE] } },
        }
  ) as Variants;
  return { container, item, prefersReduced };
}

// — Shared extended props ————————————————————————————

export interface EditorialExtendedProps extends EditorialLayoutProps {
  /** Oversized serif numeral, e.g. "01" — used by Portrait & Magazine. */
  numeral?: ReactNode;
  /** Oversized bottom wordmark on the accent block — used by Agency. */
  wordmark?: ReactNode;
  /** Outlined or filled CTA button — used by Portrait & Agency. */
  cta?: { label: string; href: string };
  /** Stacked social or footer links — used by Agency. */
  socialLinks?: ReactNode;
  /** Small brand mark for top corner — used by Portrait & Agency. */
  brandMark?: ReactNode;
  /** Small bottom caption — used by Portrait. */
  caption?: ReactNode;
  /** Top mini-nav (string chips) — used by Portrait. */
  nav?: string[];
}

// — Variant 6: Portrait — editorial portrait with oversized serif numeral ——

