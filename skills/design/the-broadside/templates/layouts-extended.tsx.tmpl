        <motion.div variants={item} className="mt-12 flex items-stretch gap-8 md:mt-16">
          <span
            aria-hidden="true"
            className="w-px shrink-0 self-stretch"
            style={{ backgroundColor: accent.bg, minHeight: 140 }}
