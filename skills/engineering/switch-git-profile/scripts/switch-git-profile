#!/usr/bin/env bash
# switch-git-profile (alias: sgp)
# Lists the GitHub CLI accounts you are logged in to and switches the active one.
#
#   sgp              pick an account from a numbered list
#   sgp list         print accounts, one per line: <n> <host> <login> <active|->
#   sgp <login>      switch straight to that account
#   sgp add          log in to another account (gh auth login)
#   sgp -h           help
set -euo pipefail

bold=$'\033[1m'; dim=$'\033[2m'; green=$'\033[32m'; reset=$'\033[0m'
[ -t 1 ] || { bold=""; dim=""; green=""; reset=""; }

die() { printf '%s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
}

require_gh() {
  command -v gh >/dev/null 2>&1 || die "gh is not installed. Install it with: brew install gh"
  gh auth switch --help >/dev/null 2>&1 \
    || die "gh $(gh --version | head -1 | awk '{print $3}') cannot switch accounts (needs 2.40 or later). Upgrade with: brew install gh, and check 'which gh' points at the new one."
}

# Prints "<host>\t<login>\t<active>" for every logged-in account.
accounts() {
  gh auth status 2>&1 | awk '
    /^[^ ]/ { host = $1 }
    /Logged in to .* account / {
      for (i = 1; i <= NF; i++) if ($i == "account") login = $(i + 1)
    }
    /Active account: / {
      if (login != "") printf "%s\t%s\t%s\n", host, login, ($NF == "true" ? "active" : "-")
      login = ""
    }'
}

git_context() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  local email remote
  email=$(git config user.email || true)
  remote=$(git remote get-url origin 2>/dev/null || true)
  printf '%sThis repo:%s commits as %s' "$dim" "$reset" "${email:-<no user.email>}"
  [ -n "$remote" ] && printf ', origin %s' "$remote"
  printf '\n'
}

list() {
  local n=0 host login active
  while IFS=$'\t' read -r host login active; do
    n=$((n + 1))
    printf '%s %s %s %s\n' "$n" "$host" "$login" "$active"
  done < <(accounts)
  [ "$n" -gt 0 ] || die "No gh accounts are logged in. Run: gh auth login"
}

# A gh older than 2.40 logging in overwrites the active token in hosts.yml without adding
# the account to its "users:" list. Switching away from such an account deletes its token
# for good, so refuse and say how to repair it.
guard_hosts_file() {
  local host="$1" file="${GH_CONFIG_DIR:-$HOME/.config/gh}/hosts.yml" active_user
  [ -f "$file" ] || return 0
  active_user=$(awk -v h="$host:" '$0 == h {in_h = 1; next} /^[^ ]/ {in_h = 0} in_h && /^    user: / {print $2; exit}' "$file")
  [ -n "$active_user" ] || return 0
  awk -v h="$host:" -v u="        $active_user:" '
    $0 == h {in_h = 1; next} /^[^ ]/ {in_h = 0}
    in_h && /^    users:/ {in_u = 1; next} in_h && /^    [^ ]/ {in_u = 0}
    in_h && in_u && $0 == u {found = 1}
    END {exit !found}' "$file" && return 0
  die "Stopped: $active_user on $host was logged in by an old gh, and switching away would delete its login. Repair it first with: gh auth login --hostname $host (log in as $active_user again), then rerun sgp."
}

switch_to() {
  local want="$1" host login active found=""
  while IFS=$'\t' read -r host login active; do
    if [ "$login" = "$want" ]; then found="$host"; break; fi
  done < <(accounts)
  [ -n "$found" ] || die "No logged-in account called '$want'. Run 'sgp list' to see them, or 'sgp add' to log in."
  if [ "$active" = "active" ]; then
    printf '%s%s%s is already the active account on %s.\n' "$green" "$want" "$reset" "$found"
  else
    guard_hosts_file "$found"
    gh auth switch --hostname "$found" --user "$want" >/dev/null
    printf 'Switched %s to %s%s%s.\n' "$found" "$green" "$want" "$reset"
  fi
  git_context
}

pick() {
  local rows=() host login active i choice
  while IFS=$'\t' read -r host login active; do
    rows+=("$host"$'\t'"$login"$'\t'"$active")
  done < <(accounts)
  [ "${#rows[@]}" -gt 0 ] || die "No gh accounts are logged in. Run: gh auth login"

  printf '%sGitHub accounts%s\n' "$bold" "$reset"
  for i in "${!rows[@]}"; do
    IFS=$'\t' read -r host login active <<<"${rows[$i]}"
    if [ "$active" = "active" ]; then
      printf '  %s%d) %s%s  %s(%s, active)%s\n' "$green" $((i + 1)) "$login" "$reset" "$dim" "$host" "$reset"
    else
      printf '  %d) %s  %s(%s)%s\n' $((i + 1)) "$login" "$dim" "$host" "$reset"
    fi
  done
  printf '  a) log in to another account\n'
  git_context
  printf 'Switch to [1-%d, a, enter to cancel]: ' "${#rows[@]}"
  read -r choice || exit 0

  case "$choice" in
    "") exit 0 ;;
    a|A) exec gh auth login ;;
    *[!0-9]*) die "Not a number: $choice" ;;
  esac
  [ "$choice" -ge 1 ] && [ "$choice" -le "${#rows[@]}" ] || die "Pick 1 to ${#rows[@]}."
  IFS=$'\t' read -r host login active <<<"${rows[$((choice - 1))]}"
  switch_to "$login"
}

case "${1:-}" in
  -h|--help|help) usage ;;
  list) require_gh; list ;;
  add) require_gh; exec gh auth login ;;
  "") require_gh; pick ;;
  *) require_gh; switch_to "$1" ;;
esac
