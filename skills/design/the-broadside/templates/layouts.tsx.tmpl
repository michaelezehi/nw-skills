'use client';
// the-broadside layout variants — five compositional shapes that share the
// same EditorialFrame + primitives but rearrange where the eyebrow,
// headline, intro, image, cards, and pagination live.

import { motion, useReducedMotion, type Variants } from 'motion/react';
import { ReactNode, useId } from 'react';
import {
  EditorialBottomCards,
  EditorialPlate,
  useAccent,
  type EditorialCard,
} from './slide';
import {
  ASH,
  CARD,
  DURATION,
  EASE,
  IMAGE_FILTER,
  INK,
  MIST,
  RAIL,
  SMOKE,
  STAGGER,
  Y_DISTANCE,
} from './tokens';

// — Shared types + animation ————————————————————————

export interface EditorialLayoutProps {
  eyebrow: string;
  headline: ReactNode;
  intro?: ReactNode;
  imageSrc?: string;
  imageObjectPosition?: string;
  visual?: ReactNode;
  cards?: EditorialCard[];
  pagination?: ReactNode;
  aside?: ReactNode;
}

function useAnim() {
  const prefersReduced = useReducedMotion();
  const container = {
    hidden: { opacity: 0 },
    visible: { opacity: 1, transition: { staggerChildren: STAGGER, delayChildren: 0.08 } },
  } satisfies Variants;
  const item = (
    prefersReduced
      ? { hidden: { opacity: 0 }, visible: { opacity: 1, transition: { duration: DURATION } } }
      : {
          hidden: { opacity: 0, y: Y_DISTANCE },
          visible: { opacity: 1, y: 0, transition: { duration: DURATION, ease: [...EASE] } },
        }
  ) as Variants;
  return { container, item, prefersReduced };
}

function HeadlineBlock({
  eyebrow,
  headline,
  intro,
}: Pick<EditorialLayoutProps, 'eyebrow' | 'headline' | 'intro'>) {
  const { item } = useAnim();
  return (
    <>
      <motion.div variants={item} className="flex items-center gap-4">
        <span
          className="font-mono text-[12px] uppercase tracking-[0.32em]"
          style={{ color: SMOKE }}
        >
          {eyebrow}
        </span>
        <span aria-hidden="true" className="h-px w-12" style={{ backgroundColor: ASH }} />
      </motion.div>
      <motion.h2
        variants={item}
        className="mt-7 max-w-[640px] text-[clamp(2rem,5.2vw,4.4rem)] font-medium leading-[1.04] tracking-[-0.028em] md:mt-10"
        style={{ color: INK, fontFamily: 'var(--font-geist-sans), system-ui, sans-serif' }}
      >
        {headline}
      </motion.h2>
      {intro && (
        <motion.div
          variants={item}
          className="mt-6 max-w-[480px] text-[14px] leading-[1.6] md:mt-8 md:text-[15px]"
          style={{ color: SMOKE }}
        >
          {intro}
        </motion.div>
      )}
    </>
  );
}

// — Variant 1: Split — text + image side-by-side, 3 cards bottom strip ——

export function EditorialSplit({
  imageSide = 'right',
  eyebrow,
  headline,
  intro,
  imageSrc,
  imageObjectPosition,
  visual,
  cards,
  pagination,
  aside,
}: EditorialLayoutProps & { imageSide?: 'left' | 'right' }) {
  const { container } = useAnim();
  const text = (
    <motion.div
      variants={container}
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true, amount: 0.2 }}
      className="flex w-full flex-col justify-center px-6 py-10 md:px-10 md:py-12 lg:px-16"
    >
      <HeadlineBlock eyebrow={eyebrow} headline={headline} intro={intro} />
      {pagination && <div className="mt-8 md:mt-10">{pagination}</div>}
      {aside && <div className="mt-8 md:mt-10">{aside}</div>}
    </motion.div>
  );

  const visualBlock = visual ?? (
    <EditorialPlate src={imageSrc!} objectPosition={imageObjectPosition} className="h-full w-full" />
  );

  return (
    <>
      <div
        className={`flex min-h-0 flex-[7] basis-0 ${
          imageSide === 'right' ? 'flex-col-reverse md:flex-row' : 'flex-col-reverse md:flex-row-reverse'
        }`}
      >
        <div className="flex md:w-[48%] lg:w-[46%]">{text}</div>
        <div
          className={`relative h-[40vh] w-full md:h-auto md:flex-1 ${
            imageSide === 'right'
              ? 'md:pr-8 md:pt-8 md:pb-8 lg:pr-12 lg:pt-10 lg:pb-10'
              : 'md:pl-8 md:pt-8 md:pb-8 lg:pl-12 lg:pt-10 lg:pb-10'
          }`}
        >
          <div
            className="relative h-full w-full overflow-hidden"
            style={{ outline: `1px solid ${RAIL}`, outlineOffset: -1 }}
          >
            {visualBlock}
          </div>
        </div>
      </div>
      {cards && cards.length > 0 && <EditorialBottomCards cards={cards} />}
    </>
  );
}

// — Variant 2: Overlay — image dominates, bold uppercase headline overlaid,
//   bottom band of dark / accent shout / description ————————————————————

export function EditorialOverlay({
  eyebrow,
  headline,
  intro,
  imageSrc,
  imageObjectPosition,
  visual,
  cards = [],
  pagination,
  aside,
}: EditorialLayoutProps) {
