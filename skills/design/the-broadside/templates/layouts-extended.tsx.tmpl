function AgencyCrown({ color }: { color: string }) {
  return (
    <svg width="32" height="22" viewBox="0 0 32 22" fill="none" aria-hidden="true">
      <path d="M2 4 L8 18 L16 6 L24 18 L30 4 L26 20 L6 20 Z" fill={color} />
    </svg>
  );
}

function AgencyImageCard({ card }: { card?: EditorialCard }) {
  if (!card || card.kind !== 'image') {
    return (
      <div
        className="relative flex aspect-[4/5] flex-col justify-end overflow-hidden p-5"
        style={{ backgroundColor: MIST }}
      >
        {card?.eyebrow && (
          <p className="font-mono text-[10px] uppercase tracking-[0.32em]" style={{ color: SMOKE }}>
            {card.eyebrow}
          </p>
        )}
        {card?.title && (
          <h4
            className="mt-2 text-[15px] font-medium leading-[1.25] tracking-[-0.01em]"
            style={{ color: INK }}
          >
            {card.title}
          </h4>
        )}
      </div>
    );
  }
  return (
    <div className="relative aspect-[4/5] overflow-hidden" style={{ backgroundColor: '#0A0A0A' }}>
      {/* eslint-disable-next-line @next/next/no-img-element */}
      <img
        src={card.imageSrc}
        alt=""
        aria-hidden="true"
        className="absolute inset-0 h-full w-full object-cover"
        style={{ filter: IMAGE_FILTER }}
      />
      {card.eyebrow && (
        <div className="relative flex h-full flex-col justify-start p-4 text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.55)]">
          <p className="font-mono text-[10px] uppercase tracking-[0.32em] text-white/85">
            {card.eyebrow}
          </p>
        </div>
      )}
    </div>
  );
}

function AgencySideCard({ card }: { card: EditorialCard }) {
  const accent = useAccent();
  if (card.kind === 'image') {
    return (
      <div className="relative aspect-square overflow-hidden" style={{ backgroundColor: '#0A0A0A' }}>
        {/* eslint-disable-next-line @next/next/no-img-element */}
        <img
          src={card.imageSrc}
          alt=""
          aria-hidden="true"
          className="absolute inset-0 h-full w-full object-cover"
          style={{ filter: IMAGE_FILTER }}
        />
      </div>
    );
  }
  const bg = card.kind === 'dark' ? '#0A0911' : card.kind === 'red' ? accent.bg : '#FAFAFA';
  const fg = card.kind === 'dark' ? '#FFFFFF' : card.kind === 'red' ? accent.ink : '#0A0911';
  return (
    <div
      className="relative flex aspect-square flex-col justify-end overflow-hidden p-5"
      style={{ backgroundColor: bg, color: fg }}
    >
      <p className="font-mono text-[10px] uppercase tracking-[0.32em] opacity-70">{card.eyebrow}</p>
      {card.title && (
        <h4 className="mt-2 text-[15px] font-medium leading-[1.25] tracking-[-0.01em]">{card.title}</h4>
      )}
    </div>
  );
}

