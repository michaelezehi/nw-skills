            {cta && (
              <a
                href={cta.href}
                className="inline-flex items-center justify-center self-start px-8 py-5 font-mono text-[11px] uppercase tracking-[0.28em] transition-colors hover:opacity-80"
                style={{ color: INK, border: `1px solid ${INK}` }}
