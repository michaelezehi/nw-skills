      viewport={{ once: true, amount: 0.2 }}
      className="flex min-h-screen w-full flex-1 flex-col md:flex-row"
    >
      <div
        className="relative flex min-h-[460px] flex-col overflow-hidden md:min-h-0 md:w-[30%]"
        style={{ backgroundColor: accent.bg, color: accent.ink }}
      >
        <div className="relative z-20 flex items-center justify-between px-6 pt-6 md:px-8 md:pt-8">
          {brandMark ?? <AgencyCrown color={accent.ink} />}
        </div>
        <div className="relative flex-1">{heroVisual}</div>
