          <div className="flex w-full flex-col justify-center px-6 py-10 md:px-10 md:py-12 lg:px-16">
            <HeadlineBlock eyebrow={eyebrow} headline={headline} intro={intro} />
            {pagination && <div className="mt-8 md:mt-10">{pagination}</div>}
            {aside && <div className="mt-8 md:mt-10">{aside}</div>}
          </div>
        </div>
        <div className="relative h-[36vh] w-full md:h-auto md:flex-1 md:pr-8 md:pt-2 md:pb-10 lg:pr-12 lg:pb-12">
          <div className="relative h-full w-full overflow-hidden" style={{ outline: `1px solid ${RAIL}`, outlineOffset: -1 }}>
            {visualBlock}
          </div>
        </div>
      </div>
    </motion.div>
